# Committed to git: NO secrets here. Put secrets in .env.local (dev) or the Vercel dashboard (prod).
# App Name
NEXT_PUBLIC_APP_NAME="SubTrack"

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth configuration
NEXT_PUBLIC_AUTH_SIGNUP_URL=/sign-up
NEXT_PUBLIC_AUTH_SIGNIN_URL=/sign-in
NEXT_PUBLIC_AUTH_AFTER_SIGNIN_URL=/dashboard
NEXT_PUBLIC_AUTH_AFTER_SIGNUP_URL=/onboarding

# Analytics (Plausible, cookieless). Leave unset to keep analytics off.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=subtrack.example